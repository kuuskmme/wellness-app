# Environment Variables for Numbers-Don't-Lie Wellness Platform

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local MongoDB: mongodb://localhost:27017/wellness-platform
# For MongoDB Atlas (with encryption): mongodb+srv://username:password@cluster.mongodb.net/wellness-platform
MONGODB_URI=mongodb://localhost:27017/wellness-platform

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration (for later steps)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# AI Configuration (for later steps)
OPENAI_API_KEY=your-openai-api-key

# Encryption Keys
ENCRYPTION_KEY=your-32-character-encryption-key-here