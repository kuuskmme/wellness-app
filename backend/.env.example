# Environment Variables for Numbers-Don't-Lie Wellness Platform
# Step 2: Complete Authentication Configuration

# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# Database Configuration
# ==========================================
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/wellness-platform

# For MongoDB Atlas (with encryption at rest):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wellness-platform?retryWrites=true&w=majority

# ==========================================
# JWT Configuration
# ==========================================
# Generate secure secrets: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ==========================================
# Frontend URL (for CORS and redirects)
# ==========================================
FRONTEND_URL=http://localhost:3000

# ==========================================
# Email Configuration (SMTP)
# ==========================================
# For Gmail (need app-specific password):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# For development (leave empty to use Ethereal fake SMTP):
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=

# For other providers:
# Outlook: smtp-mail.outlook.com (port 587)
# Yahoo: smtp.mail.yahoo.com (port 587 or 465)
# SendGrid: smtp.sendgrid.net (port 587)

# ==========================================
# OAuth Configuration (Google)
# ==========================================
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# OAuth Configuration (GitHub)
# ==========================================
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ==========================================
# AI Configuration (for Step 4)
# ==========================================
OPENAI_API_KEY=your-openai-api-key

# Or use alternative AI providers:
# ANTHROPIC_API_KEY=your-anthropic-key
# HUGGINGFACE_API_KEY=your-huggingface-key

# ==========================================
# Rate Limiting Configuration
# ==========================================
# Max requests per window (optional, defaults are set in code)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# Session Configuration (optional)
# ==========================================
SESSION_SECRET=your-session-secret-change-this

# ==========================================
# Encryption Keys (optional)
# ==========================================
ENCRYPTION_KEY=your-32-character-encryption-key-here

# ==========================================
# 2FA Configuration (optional)
# ==========================================
TWO_FACTOR_APP_NAME=Wellness Platform
TWO_FACTOR_ISSUER=WellnessPlatform

# ==========================================
# Logging (optional)
# ==========================================
LOG_LEVEL=debug  # error, warn, info, debug
LOG_FILE=app.log

# ==========================================
# Development/Testing
# ==========================================
# Set to true to disable email sending in development
DISABLE_EMAIL=false

# Set to true to auto-verify new accounts (development only!)
AUTO_VERIFY_ACCOUNTS=false

# ==========================================
# IMPORTANT NOTES:
# ==========================================
# 1. Never commit this file with real values to version control
# 2. Generate strong secrets for production: openssl rand -base64 32
# 3. Use environment-specific files: .env.development, .env.production
# 4. For OAuth, ensure redirect URIs match your configuration:
#    - Google: http://localhost:5000/api/auth/google/callback
#    - GitHub: http://localhost:5000/api/auth/github/callback
# 5. For email, Gmail requires "App Passwords" not your regular password
# 6. MongoDB Atlas provides free tier with encryption at rest